ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio cache files
*.suo
*.user
*.sln.docstates

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# Logs
Logs/
*.log

# Database
*.db
*.db-shm
*.db-wal

# Migrations (uncomment if you want to ignore migrations)
# **/Migrations/

# appsettings with secrets
appsettings.secrets.json
appsettings.*.secrets.json

# User secrets
secrets.json

# Files
wwwroot/files/
App_Data/

# Certificates
*.pfx
*.p12

# Others
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Backup & report files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# Node.js Tools for Visual Studio
.ntvs_analysis.dat
node_modules/

# Typescript v1 declaration files
typings/

# Visual Studio 6 build log
*.plg

# Visual Studio 6 workspace options file
*.opt

# JetBrains Rider
.idea/
*.sln.iml

# Mac
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Publish profiles
PublishProfiles/
*.pubxml
*.azurePubxml

# Package Files
*.nupkg
*.snupkg
**/packages/*

# Except build/, which is used as an MSBuild target.
!**/packages/build/

# Uncomment if necessary however generally it will be regenerated when needed
#!**/packages/repositories.config

# NuGet Packages Directory
packages/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Entity Framework Migrations
# Uncomment to ignore migrations
# **/Migrations/*.cs
# !**/Migrations/*Configuration.cs
